{
  "schema_version": 30,

  "workflow": {
    "create_instances": false,
    "generate_training_data": false,
    "train_gnn": false,
    "solve": true,
    "evaluate": false
  },

  "instances": {
    "generation": {
      "num_jobs": [3, 4, 5],
      "num_machines": [3, 4, 5],
      "operations_per_job": [3, 5],
      "instances_per_size": 35,
      "random_seed": 69,
      "processing_times": {
        "base_range": [5, 15]
      },
      "machine_profiles": {
        "profiles": {
          "old": {
            "cost_rate": 1.00,
            "speed": 0.80,
            "weibull_alpha": 60.0,
            "weibull_beta": 3.0,
            "repair_rate": 0.15
          },
          "new": {
            "cost_rate": 1.60,
            "speed": 1.25,
            "weibull_alpha": 100.0,
            "weibull_beta": 2.0,
            "repair_rate": 0.40
          }
        },
        "parameter_jitter": {
          "cost_rate": 0.0,
          "speed": 0.0,
          "weibull_alpha": 0.0,
          "repair_rate": 0.0
        },
        "operation_time_noise": [0.90, 1.10],
        "minimum_profile_classes_per_operation": 2,
        "all_profiles_probability": 0.0,
        "additional_same_profile_machine_probability": 0.25
      },
      "due_dates": {
        "method": "fjsp_lower_bound_factors",
        "factors": [1.25, 1.30, 1.40, 1.55],
        "assignment": "cyclic"
      },
      "split_ratios": {
        "train": 0.80,
        "valid": 0.10,
        "test": 0.10
      }
    }
  },

  "objective": {
    "type": "minimize_processing_plus_operating_cost",
    "facility_cost_per_time": 1.0
  },

  "solve": {
    "solvers": ["gurobi_nonlinear", "gurobi_gnn", "gurobi"],
    "evaluation": {
      "random_seed": 2026,
      "instance_directory": "02_data/fjsp_instances",
      "in_distribution": {
        "enabled": false,
        "instances_per_size": 2
      },
      "benchmark": {
        "enabled": true,
        "reuse_existing_instances": true,
        "num_jobs": [5],
        "num_machines": [3],
        "instances_per_size": 5,
        "due_date_factors": [1.60]
      },
      "extrapolation": {
        "enabled": false,
        "reuse_existing_instances": true,
        "num_jobs": [7],
        "num_machines": [4],
        "instances_per_size": 1,
        "due_date_factor": 1.60
      },
      "stress": {
        "enabled": false,
        "reuse_existing_instances": true,
        "num_jobs": [10],
        "num_machines": [5],
        "instances_per_size": 1,
        "due_date_factor": 1.60
      }
    }
  },

  "evaluation": {
    "solutions_directory": "02_data/fjsp_solutions",
    "instances_directory": "02_data/fjsp_instances",
    "output_directory": "06_Evaluation/results",
    "replications": 2000,
    "random_seed": 900042,
    "wilson_confidence": 0.95,
    "simulation": {
      "random_seed": 900042
    },
    "dataset_diagnostics": {
      "enabled": true,
      "dataset_directory": "02_data/gnn_dataset",
      "histogram_bins": 20
    },
    "prediction_diagnostics": {
      "enabled": true,
      "calibration_bins": 10
    }
  },

  "constraint": {
    "type": "weibull",
    "weibull": {
      "reliability_graph": {
        "quadrature_points": 12,
        "service_scope": "job"
      }
    }
  },

  "training": {
    "data_generation": {
      "method": "fix_and_optimize",
      "samples_per_instance": 4,
      "output_directory": "02_data/gnn_dataset",
      "generate_splits": {
        "training": true,
        "valid": true,
        "test": true
      },
      "random_seed": 42,
      "weibull_scale_factors": [1.0],
      "adaptive_due_dates": {
        "enabled": true,
        "relative_makespan_offsets": [0.02, 0.05, 0.10, 0.20],
        "time_limit_seconds": 2,
        "mip_gap": 0.01,
        "output_flag": 0,
        "seed": 42,
        "maximum_candidate_pool_runs": 4
      },
      "instance_failure_handling": {
        "summary_filename": "generation_summary.json"
      },
      "fixed_y": {
        "time_limit_seconds": 1,
        "output_flag": 0,
        "pool_candidates": 10,
        "minimum_candidate_pool_runs": 4,
        "pool_search_mode": 2,
        "pool_gap": 1.0,
        "mip_gap": 0.05,
        "mip_focus": 1,
        "fix_ratios": [0.25, 0.50, 0.75],
        "label_distribution_center": 0.50,
        "label_distribution_half_width": 0.25,
        "candidate_generation_mode": "nonlinear_evaluated",
        "nonlinear_probability_bands": {
          "enabled": false,
          "target_ratios": {
            "low": 0.10,
            "boundary_below": 0.40,
            "boundary_above": 0.40,
            "high": 0.10
          }
        },
        "hybrid_selection": {
          "enabled": true,
          "anchor_fraction": 0.10,
          "anchor_ratios": {
            "good_nominal_objective": 0.30,
            "high_min_job_probability": 0.20,
            "pareto_tradeoff": 0.20,
            "structurally_diverse": 0.30
          },
          "job_probability_target_ratios": {
            "low": 0.25,
            "boundary_below": 0.25,
            "boundary_above": 0.25,
            "high": 0.25
          },
          "probability_target_basis": "job_probabilities",
          "maximum_candidate_pool_runs": 4,
          "final_job_probability_coverage": {
            "apply_to_splits": [],
            "minimum_ratios": {
              "boundary_below": 0.10,
              "boundary_above": 0.10
            }
          }
        },
        "pool_selection_ratios": {
          "service_boundary_below": 0.25,
          "service_boundary_above": 0.15,
          "high_min_job_probability": 0.15,
          "low_min_job_probability": 0.10,
          "good_nominal_objective": 0.15,
          "pareto_tradeoff": 0.10,
          "structurally_diverse": 0.10
        }
      }
    },

    "gnn": {
      "seed": 42,
      "model_directory": "04_GraphNeuralNetworks/trained_gnn_models",
      "combinations": [
        {
          "variant": "linear_baseline",
          "convolution": "linear",
          "layers": [1],
          "hidden_channels": [4]
        },
        {
          "variant": "fixed_job_graphsage",
          "convolution": "job",
          "layers": [1],
          "hidden_channels": [4]
        },
        {
          "variant": "decision_dependent_direct_machine_job_graphsage",
          "convolution": "sage",
          "layers": [1],
          "hidden_channels": [4]
        }
      ],

      "optimizer": {
        "epochs": 1000,
        "batch_size": 64,
        "learning_rate": 0.001
      },

      "loss": {
        "name": "mse"
      },

      "validation": {
        "interval_epochs": 10,
        "patience_epochs": 30,
        "enforce_graph_influence": false
      }
    }
  },

  "solvers": {
    "gurobi": {
      "common": {
        "OutputFlag": 0,
        "TimeLimit": 3600,
        "MIPGap": 0.000,
        "Threads": 0,
        "Seed": 42
      },
      "gnn": {
        "add_schedule_upper_bounds": true,
        "analytic_bounds": true,
        "write_solution": true
      },

      "nonlinear": {
        "Presolve": 0,
        "NumericFocus": 3,
        "MIPFocus": 1,
        "write_solution": true,
        "plot_solution_schedule": false,
        "plot_solution_graph": false,
        "plot_candidate_graph": false,
        "plot_solution_graph_style": "disjunctive",
        "plot_output_directory": "plots/fjsp_solution_plots"
      }
    }
  }
}
