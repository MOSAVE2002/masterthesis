      },
      "split_ratios": {
        "train": 0.8,
        "valid": 0.1,
        "test": 0.1
      }
    }
  },
  "objective": {
    "type": "minimize_processing_plus_operating_plus_tardiness_cost",
    "facility_cost_per_time": 1.0,
    "tardiness_cost_per_time": 1.0
  },
  "solve": {
    "create_instances": true,
    "nominal_warm_start": false,
    "solvers": [
      "gurobi",
      "gurobi_nonlinear",
      "gurobi_gnn"
    ],
    "evaluation": {
      "random_seed": 2026,
      "instance_directory": "02_data/fjsp_instances",
      "in_distribution": {
        "enabled": false,
        "instances_per_size": 5
      },
      "benchmark": {
        "enabled": true,
        "reuse_existing_instances": true,
        "num_jobs": [3,5],
        "num_machines": [3,5],
        "instances_per_size": 10,
        "due_dates": {
          "method": "calibrated_total_work_content",
          "machine_aggregation": "mean",
          "relative_makespan_offsets": [
            0.0,
            0.15,
            0.3
          ],
          "time_limit_seconds": 10,
          "mip_gap": 0.01,
          "output_flag": 0,
          "seed": 42
        }
      },
      "extrapolation": {
        "enabled": false,
        "reuse_existing_instances": true,
        "num_jobs": [
          7
        ],
        "num_machines": [
          4
        ],
        "instances_per_size": 1,
        "due_dates": {
          "method": "calibrated_total_work_content",
          "machine_aggregation": "mean",
          "relative_makespan_offsets": [
            0.0,
            0.15,
            0.3
          ],
          "time_limit_seconds": 10,
          "mip_gap": 0.01,
          "output_flag": 0,
          "seed": 42
        }
      },
      "stress": {
        "enabled": false,
        "reuse_existing_instances": true,
        "num_jobs": [
          10
        ],
        "num_machines": [
          5
        ],
        "instances_per_size": 1,
        "due_date_factor": 1.6
      }
    }
  },
  "evaluation": {
    "solutions_directory": "02_data/fjsp_solutions",
    "instances_directory": "02_data/fjsp_instances",
    "output_directory": "06_Evaluation/results",
    "replications": 1000,
    "random_seed": 900042,
    "wilson_confidence": 0.95,
    "simulation": {
      "random_seed": 900042,
      "model": "preempt_resume"
    },
    "dataset_diagnostics": {
      "enabled": true,
      "dataset_directory": "02_data/gnn_dataset",
      "histogram_bins": 20
    },
    "prediction_diagnostics": {
      "enabled": true,
      "calibration_bins": 10
    },
    "numerical_analysis": {
      "enabled": true,
      "strict": true,
      "output_directory": "06_Evaluation/results/numerical_analysis"
    },
    "service_level_threshold": 0.9
  },
  "constraint": {
    "type": "weibull",
    "weibull": {
      "reliability_graph": {
        "quadrature_points": 12,
        "service_scope": "job"
      }
    }
  },
  "training": {
    "data_generation": {
      "method": "fix_and_optimize",
      "samples_per_instance": 12,
      "output_directory": "02_data/gnn_dataset",
      "generate_splits": {
        "training": true,
        "valid": true,
        "test": true
      },
      "random_seed": 42,
      "weibull_scale_factors": [
        0.8,
        1.0,
        1.2
      ],
      "adaptive_due_dates": {
        "enabled": true,
        "method": "calibrated_total_work_content",
        "machine_aggregation": "mean",
        "relative_makespan_offsets": [
          0.0,
          0.15,
          0.3,
          0.45
        ],
        "time_limit_seconds": 10,
        "mip_gap": 0.01,
        "output_flag": 0,
        "seed": 42,
        "maximum_candidate_pool_runs": 4,
        "candidate_selection": {
          "ensure_all_categories": false,
          "rotate_repeated_categories": true,
          "rotate_surplus_offsets": true,
          "prefer_unique_structures": true
        }
      },
      "instance_failure_handling": {
        "summary_filename": "generation_summary.json"
      },
      "fixed_y": {
        "time_limit_seconds": 1,
        "output_flag": 0,
        "pool_candidates": 20,
        "minimum_candidate_pool_runs": 4,
        "pool_search_mode": 2,
        "pool_gap": 1.0,
        "mip_gap": 0.05,
        "mip_focus": 1,
        "fix_ratios": [
          0.25,
          0.5,
          0.75
        ],
        "label_distribution_center": 0.9,
        "label_distribution_half_width": 0.05,
        "candidate_generation_mode": "nonlinear_evaluated",
        "nonlinear_probability_bands": {
          "enabled": false,
          "target_ratios": {
            "low": 0.1,
            "boundary_below": 0.4,
            "boundary_above": 0.4,
            "high": 0.1
          }
        },
        "hybrid_selection": {
          "enabled": false,
          "anchor_fraction": 0.1,
          "anchor_ratios": {
            "good_nominal_objective": 0.25,
            "low_expected_completion_delay": 0.2,
            "high_expected_completion_delay": 0.2,
            "pareto_tradeoff": 0.15,
            "structurally_diverse": 0.2
          },
          "job_probability_target_ratios": {
            "low": 0.25,
            "boundary_below": 0.25,
            "boundary_above": 0.25,
            "high": 0.25
          },
          "probability_target_basis": "job_probabilities",
          "maximum_candidate_pool_runs": 4,
          "final_job_probability_coverage": {
            "apply_to_splits": [],
            "minimum_ratios": {
              "boundary_below": 0.1,
              "boundary_above": 0.1
            }
          }
        },
        "pool_selection_ratios": {
          "service_boundary_below": 0.15,
          "service_boundary_above": 0.15,
          "low_expected_completion_delay": 0.15,
          "medium_expected_completion_delay": 0.1,
          "high_expected_completion_delay": 0.15,
          "good_nominal_objective": 0.1,
          "pareto_tradeoff": 0.1,
          "structurally_diverse": 0.1
        },
        "selection_method": "buffer_structure_cost",
        "maximum_candidate_pool_runs": 4
      },
      "labels": {
        "method": "local_midpoint_expectation_quadrature_checked_v1",
        "quadrature_points": 128,
        "verification_points": 256,
        "absolute_tolerance": 1e-06
      }
    },
    "gnn": {
      "seed": 42,
      "model_directory": "04_GraphNeuralNetworks/trained_gnn_models",
      "combinations": [
        {
          "variant": "linear_baseline",
          "convolution": "linear",
          "layers": [1,2],
          "hidden_channels": [4,8]
        },
        {
          "variant": "fixed_job_graphsage",
          "convolution": "job",
          "layers": [1,2],
          "hidden_channels": [4,8]
        },
        {
          "variant": "decision_dependent_direct_machine_job_graphsage",
          "convolution": "sage",
          "layers": [1,2],
          "hidden_channels": [ 4,8]
        }
      ],
      "optimizer": {
        "epochs": 3000,
        "batch_size": 256,
        "learning_rate": 0.001,
        "cache_batches": true
      },
      "loss": {
        "name": "mse"
      },
      "validation": {
        "interval_epochs": 25,
        "patience_epochs": 200,
        "enforce_graph_influence": false
      }
    }
