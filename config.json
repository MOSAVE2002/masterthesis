            "repair_rate": 0.016666666666666666
          },
          "new": {
            "cost_rate": 1.6,
            "speed": 1.25,
            "weibull_alpha": 200.0,
            "weibull_beta": 2.0,
            "repair_rate": 0.03333333333333333
          }
        },
        "parameter_jitter": {
          "cost_rate": 0.0,
          "speed": 0.0,
          "weibull_alpha": 0.0,
          "repair_rate": 0.0
        },
        "operation_time_noise": [
          0.9,
          1.1
        ],
        "minimum_profile_classes_per_operation": 2,
        "all_profiles_probability": 0.0,
        "additional_same_profile_machine_probability": 0.25
      },
      "training_parameter_jitter": {
        "enabled": true,
        "fraction_per_size": 0.2,
        "random_seed": 20260914,
        "parameter_jitter": {
          "cost_rate": 0.0,
          "speed": 0.0,
          "weibull_alpha": 0.05,
          "repair_rate": 0.05
        }
      },
      "due_dates": {
